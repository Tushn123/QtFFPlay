prefix=/c/shn/workspace/source/ffmpeg-6.1.1-source-build/install
exec_prefix=${prefix}
libdir=/c/shn/workspace/source/ffmpeg-6.1.1-source-build/install/lib
includedir=/c/shn/workspace/source/ffmpeg-6.1.1-source-build/install/include

Name: libavformat
Description: FFmpeg container format library
Version: 60.16.100
Requires: 
Requires.private: libavcodec >= 60.31.102, libswresample >= 4.12.100, libavutil >= 58.29.100
Conflicts:
Libs: -L${libdir}  -lavformat 
Libs.private: -lm -latomic -lxml2 -lbz2 -lz -lssl -lcrypto -lsrt -lws2_32 -lssh
Cflags: -I${includedir}
